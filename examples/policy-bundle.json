  "bundleVersion": 1,
  "policies": [
    {
      "policyKey": "api-request-control",
      "activeVersion": 3,
      "defaults": {
        "effect": "allow"
      },
      "rules": [
        {
          "id": "deny-admin-from-public",
          "status": "active",
          "priority": 100,
          "target": {
            "service": "api-gateway",
            "resource": "*",
            "action": "request"
          },
          "when": {
            "op": "and",
            "conditions": [
              {
                "op": "eq",
                "path": "ctx.scope",
                "value": "public"
              },
              {
                "op": "in",
                "path": "ctx.path",
                "values": [
                  "/admin",
                  "/internal"
                ]
              }
            ]
          },
          "effect": {
            "type": "deny"
          }
        },
        {
          "id": "throttle-anonymous",
          "status": "active",
          "priority": 50,
          "target": {
            "service": "api-gateway",
            "resource": "*",
            "action": "request"
          },
          "when": {
            "op": "not",
            "condition": {
              "op": "exists",
              "path": "ctx.userId"
            }
          },
          "effect": {
            "type": "throttle",
            "throttle": {
              "limit": 60,
              "windowSeconds": 60,
              "key": "ip"
            }
          }
        }
      ]
    },
    {
      "policyKey": "login-protection",
      "activeVersion": 1,
      "defaults": {
        "effect": "allow"
      },
      "rules": [
        {
          "id": "deny-after-five-failures",
          "status": "active",
          "priority": 100,
          "target": {
            "service": "auth",
            "resource": "login",
            "action": "authenticate"
          },
          "when": {
            "op": "gte",
            "path": "ctx.failedAttempts",
            "value": 5
          },
          "effect": {
            "type": "deny"
          }
        }
      ]
    },
    {
      "policyKey": "refund-control",
      "activeVersion": 2,
      "defaults": {
        "effect": "deny"
      },
      "rules": [
        {
