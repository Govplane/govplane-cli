{
  "name": "@govplane/cli",
  "version": "1.0.4",
  "description": "Govplane CLI — validate and inspect Govplane policy drafts and bundles locally, with no account and no network required.",
  "keywords": [
    "govplane",
    "policy",
    "governance",
    "authorization",
    "cli",
    "bundle",
    "validation"
  ],
  "homepage": "https://github.com/Govplane/govplane-cli#readme",
  "bugs": {
    "url": "https://github.com/Govplane/govplane-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Govplane/govplane-cli.git"
  },
  "license": "MIT",
  "author": "Govplane",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "govplane": "bin/govplane.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "eslint": "^9.39.1",
    "eslint-config-airbnb-extended": "^3.1.1",
    "eslint-plugin-import-x": "^4.16.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.1"
  }
}
